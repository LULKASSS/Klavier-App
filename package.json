{
  "name": "klavier-trainer",
  "version": "0.1.0",
  "author": "Lukas Rückborn",
  "private": true,
  "description": "Klavier-Trainer als Mac-App: Oberfläche und Umwandler in einem.",
  "scripts": {
    "app": "electron .",
    "app:install": "node scripts/app-installieren.mjs",
    "test": ".venv/bin/python -m unittest discover -s test && node --check desktop/main.js",
    "postinstall": "node node_modules/electron/install.js",
    "test:app": "node test/app.e2e.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "1.64.0"
  },
  "main": "desktop/main.js",
  "productName": "Klavier-Trainer",
  "build": {
    "appId": "de.rueckborn.klavier-trainer",
    "productName": "Klavier-Trainer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "desktop/icon.png",
      "identity": null
    }
  }
}